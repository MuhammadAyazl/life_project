# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local MongoDB (or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/shopfussion

# Long random string (at least 32 chars). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Where the Next.js site runs (used for CORS + CSRF origin check)
CLIENT_URL=http://localhost:3000

# Optional: Google login. Create an OAuth "Web application" client in Google Cloud Console
# and add http://localhost:3000 as an authorised JavaScript origin.
GOOGLE_CLIENT_ID=

# Stripe payments for Plus membership (https://dashboard.stripe.com/test/apikeys)
# Use TEST keys while developing. Never put the secret key in the client.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:5000/api/payments/webhook` (local) or Dashboard > Webhooks (live)
STRIPE_WEBHOOK_SECRET=

# First admin account, created by `npm run seed`
ADMIN_EMAIL=admin@shopfussion.local
ADMIN_PASSWORD=change-me-strong-password
